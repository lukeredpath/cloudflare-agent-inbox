{
  "name": "cloudflare-agent-inbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lane-based email inbox on Cloudflare Workers for AI agents. Unofficial; not affiliated with Cloudflare.",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "render-config": "node --env-file-if-exists=.env scripts/render-config-cli.ts",
    "pii-scan": "node scripts/pii-scan-cli.ts",
    "cli": "node --env-file-if-exists=.env src/cli/index.ts",
    "migrate": "wrangler d1 migrations apply DB --remote -c dist/wrangler.jsonc",
    "deploy": "node --env-file-if-exists=.env scripts/deploy-cli.ts",
    "build": "npm test && npm run render-config"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.163.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261116.1": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@zip.js/zip.js": "^2.25.0",
    "cloudflare": "^7.3.0",
    "commander": "^15.1.0",
    "postal-mime": "^4.2.1",
    "zod": "^4.6.7"
  }
}
