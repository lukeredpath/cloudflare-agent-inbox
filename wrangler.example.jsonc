// Template for the real deployment config. Each angle-bracket token below is
// replaced at build time from the environment variable of the same name with
// an AGENT_INBOX_ prefix (Workers Builds build variables) by
// `npm run render-config`. The rendered file is never committed.
// See docs/deploy.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "<WORKER_NAME>",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  // The MCP host and the share-link host are separate custom domains. The admin and ingest
  // hosts are optional: leave their variables unset and their lines are dropped.
  "routes": [
    { "pattern": "<MCP_HOSTNAME>", "custom_domain": true },
    { "pattern": "<SHARE_HOSTNAME>", "custom_domain": true },
    { "pattern": "<ADMIN_HOSTNAME?>", "custom_domain": true },
    { "pattern": "<INGEST_HOSTNAME?>", "custom_domain": true },
  ],

  "vars": {
    "MAIL_HOSTNAME": "<MAIL_HOSTNAME>",
    "MCP_HOSTNAME": "<MCP_HOSTNAME>",
    "SHARE_HOSTNAME": "<SHARE_HOSTNAME>",
    "DEFAULT_ALLOWED_SENDERS": "<DEFAULT_ALLOWED_SENDERS>",
    "ALLOWED_DKIM_DOMAINS": "<ALLOWED_DKIM_DOMAINS>",
    "TRUSTED_ARC_FORWARDERS": "<TRUSTED_ARC_FORWARDERS>",
    "ADMIN_HOSTNAME": "<ADMIN_HOSTNAME?>",
    "ACCESS_TEAM_DOMAIN": "<ACCESS_TEAM_DOMAIN?>",
    "ACCESS_AUD": "<ACCESS_AUD?>",
    "INGEST_HOSTNAME": "<INGEST_HOSTNAME?>",
    "INGEST_ACCESS_AUD": "<INGEST_ACCESS_AUD?>",
  },

  // The admin app (built by `npm run build:admin`). The Worker runs first so every request
  // on the admin host passes the Access check before any file is served.
  "assets": {
    "directory": "dist/admin",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },

  // No resource ids: Wrangler provisions D1 and R2 on first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "<WORKER_NAME>", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "<WORKER_NAME>" }],

  // Cloudflare's rate-limiting binding: mail from unlisted senders is limited per location
  // (20 per 10 seconds) before any database work. namespace_id only has to be an integer
  // that no other rate limiter in your account uses. INGEST_LIMITER limits each ingest key
  // (60 a minute); it only counts requests that passed the signature check.
  "ratelimits": [
    { "name": "MAIL_LIMITER", "namespace_id": "51730", "simple": { "limit": 20, "period": 10 } },
    { "name": "INGEST_LIMITER", "namespace_id": "51731", "simple": { "limit": 60, "period": 60 } },
  ],

  // Hourly purge of expired and deleted data.
  "triggers": { "crons": ["17 * * * *"] }
}
