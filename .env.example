# Copy to .env.deploy (git-ignored) or export these in your shell. Never commit real values.
# If you use a 1Password Environment, mount it at .env.deploy, not .env: Vitest and Wrangler
# auto-read .env, and a mounted file can only be read by one process at a time.

# Deployment settings, used to render the Worker's config at deploy time.
AGENT_INBOX_WORKER_NAME=
AGENT_INBOX_MAIL_HOSTNAME=mail.example.com
AGENT_INBOX_MCP_HOSTNAME=mcp.example.com
AGENT_INBOX_SHARE_HOSTNAME=files.example.com
AGENT_INBOX_DEFAULT_ALLOWED_SENDERS=you@example.com
AGENT_INBOX_ALLOWED_DKIM_DOMAINS=example.com
AGENT_INBOX_TRUSTED_ARC_FORWARDERS=forwarder.example.net

# Cloudflare access.
CLOUDFLARE_ACCOUNT_ID=
# Used by `npm run deploy`: broad (Workers, D1, R2, routes, DNS).
CLOUDFLARE_API_TOKEN=
# Used by `npm run cli`: narrow (D1 edit and Workers Scripts edit only). Falls back to the token above.
AGENT_INBOX_CLI_API_TOKEN=
