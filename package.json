{
  "name": "cloudflare-agent-inbox",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Experimental: lane-based email inbox on Cloudflare Workers for AI agents. Unofficial; not affiliated with Cloudflare.",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin",
    "render-config": "node scripts/render-config-cli.ts",
    "pii-scan": "node scripts/pii-scan-cli.ts",
    "cli": "node src/cli/index.ts",
    "deploy": "node scripts/deploy-cli.ts",
    "build:admin": "vite build",
    "dev": "node scripts/dev-cli.ts",
    "screenshots": "node scripts/screenshots.ts",
    "dev:admin": "vite",
    "build": "npm test && npm run build:admin && npm run render-config"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "playwright-core": "^1.65.1",
    "preact": "^11.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261116.1": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@zip.js/zip.js": "^2.25.0",
    "cloudflare": "^7.3.0",
    "commander": "^15.1.0",
    "postal-mime": "^4.2.1",
    "zod": "^4.6.7"
  }
}
